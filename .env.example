# Copy this file to .env and paste your keys. .env is gitignored — never commit real keys.
# All of these have free tiers that need no credit card (see guides/free-compute.md).

GROQ_API_KEY=          # https://console.groq.com/keys  (default for development)
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=    # https://openrouter.ai/keys
HF_TOKEN=              # https://huggingface.co/settings/tokens
COHERE_API_KEY=        # https://dashboard.cohere.com/api-keys  (Phase 7 reranking)
